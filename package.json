{
  "name": "react-example",
  "private": true,
  "version": "1.5.1-beta",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:cliente": "vite --mode cliente --port=3000 --host=0.0.0.0",
    "dev:test": "vite --mode test --port=3000 --host=0.0.0.0",
    "build": "npm run i18n:check && vite build",
    "build:cliente": "npm run i18n:check && vite build --mode cliente",
    "build:pro": "npm run i18n:check && vite build --mode production",
    "preview": "vite preview --host 0.0.0.0",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx tests/verify_core.ts && tsx --test tests/sync.test.ts",
    "test:sync-browser": "npm run build && node tests/sync.browser.mjs",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:check": "lingui compile --strict",
    "i18n": "lingui extract && lingui compile"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@google/genai": "^2.4.0",
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@monaco-editor/react": "^4.7.0",
    "@sanity/client": "^8.7.0",
    "@sanity/sdk-react": "^3.7.0",
    "@sanity/vision": "^6.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/diff": "^8.0.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "dagre": "^0.8.5",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.4.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.7.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sanity": "^6.17.0",
    "styled-components": "^6.5.3",
    "tldraw": "^5.4.2",
    "unified": "^11.0.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.9.0",
    "@lingui/cli": "^6.9.0",
    "@lingui/format-json": "^6.9.0",
    "@lingui/swc-plugin": "^6.7.0",
    "@lingui/vite-plugin": "^6.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-macros": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
